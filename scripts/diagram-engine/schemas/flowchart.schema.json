{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/flowchart.schema.json",
  "title": "Program Flowchart",
  "description": "Locally authored type (not part of upstream archify): a top-down program control-flow chart with start/end terminals, process steps, decision branches with condition labels, explicit loop markers and exception paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "flowchart"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "output"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "$ref": "common.schema.json#/$defs/portableOutputPath"
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/locale"
        },
        "translations": {
          "$ref": "common.schema.json#/$defs/translations"
        },
        "animation": {
          "$ref": "common.schema.json#/$defs/animation"
        },
        "visual_preset": {
          "$ref": "common.schema.json#/$defs/visualPreset"
        },
        "quality_profile": {
          "$ref": "common.schema.json#/$defs/qualityProfile"
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "common.schema.json#/$defs/legendMode" },
            "start": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "end": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "process": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "decision": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "loop": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "exception": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "io": { "$ref": "common.schema.json#/$defs/legendEntry" }
          }
        },
        "views": {
          "$ref": "common.schema.json#/$defs/guidedViews"
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 320
            },
            {
              "type": "number",
              "minimum": 320
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gapX": {
          "type": "number",
          "minimum": 24
        },
        "gapY": {
          "type": "number",
          "minimum": 32
        },
        "nodeW": {
          "type": "number",
          "minimum": 120
        },
        "nodeH": {
          "type": "number",
          "minimum": 40
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "description": "start/end are terminals; process is a step; decision is a condition with >=2 outgoing labelled edges; loop is an explicit loop head; exception is a failure or rollback step; io is an input/output step.",
            "enum": [
              "start",
              "end",
              "process",
              "decision",
              "loop",
              "exception",
              "io"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sublabel": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "brand": {
            "$ref": "common.schema.json#/$defs/brandMark"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "from": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "description": "The branch condition or edge meaning (for example 是 / 否 / 重试). Authored labels are never deleted to fix geometry.",
            "type": "string"
          },
          "role": {
            "enum": [
              "main",
              "branch",
              "loop",
              "exception"
            ]
          },
          "variant": {
            "$ref": "common.schema.json#/$defs/variant"
          },
          "route": {
            "description": "Per-relationship path control; 'auto' (default), 'straight', 'right-channel', 'left-channel'.",
            "enum": [
              "auto",
              "straight",
              "right-channel",
              "left-channel"
            ]
          }
        }
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  }
}
